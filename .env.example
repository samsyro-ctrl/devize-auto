# Cheie OpenRouter, DEDICATA devize-auto (nu partajata cu recrutare-bot/
# licitatie-analiza -- separata intentionat, ca sa se vada consumul propriu
# si sa se aleaga modele independent). openrouter.ai/workspaces/build-fix/keys
# -- toate cererile catre Claude trec prin OpenRouter, nu direct prin Anthropic
# (acelasi tipar ca recrutare-bot/src/ai.js). Nu mai e nevoie de ANTHROPIC_API_KEY.
OPENROUTER_API_KEY=

# Modelul implicit per task -- fiecare poate fi suprascris LIVE din pagina de
# Setari a panoului, fara sa atingi .env sau sa redeploiezi; astea raman doar
# valoarea de start.
MODEL_EXTRAGERE=claude-sonnet-5
MODEL_SCOP=claude-sonnet-5
MODEL_COMPLETITUDINE=claude-sonnet-5
MODEL_DESCOMPUNERE=claude-sonnet-5
MODEL_CANTITATI=claude-sonnet-5

# Folder cu fisierele .bc3 sursa (Indicatoare de norme de deviz), pentru
# scripts/importa-nomenclator.js. Vezi recrutare-bot pentru acelasi folder.
NOMENCLATOR_BC3_DIR=C:\Users\cristian.samson\Documents\SOCIETATI\DELTA CONCEPT\BUILD&FIX AI\DEVIZE

# Praguri de incredere pentru matching automat -- NU le ghici, calibreaza-le
# cu scripts/calibreaza-prag-matching.js pe un set de denumiri reale cu
# raspuns cunoscut, inainte sa ai incredere in auto-matching.
PRAG_SCOR_MATCHING=
PRAG_GAP_MATCHING=

# Procente implicite pentru centralizatorul de deviz (editabile per proiect).
ADAOS_INDIRECTE_PROCENT=10
ADAOS_PROFIT_PROCENT=5
TVA_PROCENT=19

# Radacina checkout-ului licitatie-analiza (folderul care contine "dosare/"),
# pentru "importa-licitatie" -- local relativ ("../licitatie-analiza"), pe
# server absolut ("/opt/licitatie-analiza").
LICITATIE_ANALIZA_DIR=../licitatie-analiza

# Emailul firmei-proprietar (RED POWER CONS) -- STRICT firma asta vede
# "Administrare" pe site-ul public (public-server.js/public.html), oricate
# alte firme s-ar inregistra ulterior pe platforma. Acelasi tipar ca
# EMAIL_PROPRIETAR din recrutare-bot.
EMAIL_PROPRIETAR_DEVIZE=

# === Build&Fix Core API (acelasi token, doua utilizari) ===
# 1. BFLA -- scriere/citire a potrivirilor de articol confirmate manual, vezi
#    src/bfla.js si matching.js (dinBfla). Lipsa tokenului dezactiveaza tacut
#    integrarea, nu blocheaza nimic (fail-open, vezi REGULA DE AUR in bfla.js).
# 2. RFQ -- trimite necesarul de resurse al unui proiect spre recrutare-bot
#    (prin Core API -> /api/rfq), vezi src/rfq.js. Spre deosebire de BFLA, NU
#    e fail-open -- daca tokenul lipseste, butonul de RFQ arata eroare clara,
#    nu esueaza tacut (pornirea unui RFQ e o actiune ceruta explicit de om).
CORE_API_URL=http://127.0.0.1:8092
CORE_API_TOKEN=
